# =================================================================
# Drodul Phendey Ling Foundation — Environment Example
# =================================================================

NODE_ENV=production
PORT=5000

# Database Settings (MySQL 8.0 / InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=drodul_db_user
DB_PASSWORD=your_actual_aapanel_db_password
DB_NAME=drodul_phendey_ling_db

# Security & JWT Token Auth
JWT_SECRET=generate_a_random_64_char_secret_for_production
JWT_EXPIRES_IN=7d

# Uploads Directory
UPLOAD_DIR=/www/wwwroot/drodulphendeyling/uploads

# Payment Gateways (Razorpay & Stripe)
RAZORPAY_KEY_ID=your_live_razorpay_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret
STRIPE_PUBLISHABLE_KEY=your_live_stripe_publishable_key
STRIPE_SECRET_KEY=your_live_stripe_secret_key

# SMTP Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@drodulphendeyling.org
SMTP_PASS=your_live_email_app_password
EMAIL_FROM="Drodul Phendey Ling Foundation" <contact@drodulphendeyling.org>
